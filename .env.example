# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=hello@gamezanga.net

# Admin panel — long random secret; generate with `openssl rand -hex 32`.
# The /admin login exchanges it for an HTTP-only signed session cookie.
ADMIN_SECRET=replace-with-long-random-string

# Public site URL. Used for magic-link redirects AND the CSRF same-origin check.
# Dev:  http://localhost:3000
# Prod: https://www.gamezanga.net
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (CAPTCHA on /register). Site key is public; secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Upstash Redis (rate limiting + dynamic spam blocklist).
# The Vercel Upstash integration injects KV_REST_API_*; the standalone Upstash
# dashboard uses UPSTASH_REDIS_REST_*. The code accepts EITHER naming.
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=your-upstash-token
# (or) UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN

# Emergency kill switch for registration. Set to exactly "true" to make
# /api/register return 503 instantly (spam attack, maintenance). Unset to reopen.
MAINTENANCE_MODE=false

# Spam-report cron (GitHub Actions -> /api/cron/spam-report). Bearer token that
# gates the endpoint. Must match the CRON_SECRET GitHub Actions repo secret.
CRON_SECRET=replace-with-long-random-string

# Discord webhook the 3-hourly spam report posts to.
DISCORD_SPAM_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy
